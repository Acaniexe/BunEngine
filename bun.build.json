{
  "engine_name": "BunEngine",
  "version": "0.1.0",
  "modules": [
    {
      "name": "Core",
      "kind": "StaticLib",
      "target": "Engine",
      "source_dirs": ["Engine/Source/Core"],
      "include_dirs": ["Engine/Source"],
      "dependencies": [],
      "defines": ["BUN_ENGINE"]
    },
    {
      "name": "Math",
      "kind": "StaticLib",
      "target": "Engine",
      "source_dirs": ["Engine/Source/Math"],
      "include_dirs": ["Engine/Source", "Engine/ThirdParty/Vulkan/Include"],
      "dependencies": [],
      "defines": ["BUN_ENGINE"]
    },
    {
      "name": "Runtime",
      "kind": "StaticLib",
      "target": "Engine",
      "source_dirs": ["Engine/Source/Runtime"],
      "include_dirs": ["Engine/Source", "Engine/ThirdParty/Vulkan/Include"],
      "dependencies": ["Core", "Math", "RHI", "Renderer"],
      "defines": ["BUN_ENGINE"]
    },
    {
      "name": "RHI",
      "kind": "StaticLib",
      "target": "Engine",
      "source_dirs": ["Engine/Source/RHI"],
      "include_dirs": ["Engine/Source", "Engine/ThirdParty/Vulkan/Include"],
      "dependencies": ["Core", "Math"],
      "defines": ["BUN_ENGINE", "BUN_VULKAN"]
    },
    {
      "name": "Renderer",
      "kind": "StaticLib",
      "target": "Engine",
      "source_dirs": ["Engine/Source/Renderer"],
      "include_dirs": ["Engine/Source", "Engine/ThirdParty/Vulkan/Include"],
      "dependencies": ["Core", "Math", "RHI", "Assets"],
      "defines": ["BUN_ENGINE"]
    },
    {
      "name": "Physics",
      "kind": "StaticLib",
      "target": "Engine",
      "source_dirs": ["Engine/Source/Physics"],
      "include_dirs": ["Engine/Source"],
      "dependencies": ["Core", "Math"],
      "defines": ["BUN_ENGINE"]
    },
    {
      "name": "Audio",
      "kind": "StaticLib",
      "target": "Engine",
      "source_dirs": ["Engine/Source/Audio"],
      "include_dirs": ["Engine/Source", "Engine/ThirdParty/Vulkan/Include"],
      "dependencies": ["Core"],
      "defines": ["BUN_ENGINE"]
    },
    {
      "name": "Assets",
      "kind": "StaticLib",
      "target": "Engine",
      "source_dirs": ["Engine/Source/Assets"],
      "include_dirs": ["Engine/Source", "Engine/ThirdParty/Vulkan/Include", "Engine/ThirdParty/stb"],
      "dependencies": ["Core", "Math", "RHI"],
      "defines": ["BUN_ENGINE"]
    },
    {
      "name": "ECS",
      "kind": "StaticLib",
      "target": "Engine",
      "source_dirs": ["Engine/Source/ECS"],
      "include_dirs": ["Engine/Source", "Engine/ThirdParty/Vulkan/Include"],
      "dependencies": ["Core", "Math"],
      "defines": ["BUN_ENGINE"]
    },
    {
      "name": "Editor",
      "kind": "Executable",
      "target": "Editor",
      "source_dirs": ["Editor/Source"],
      "include_dirs": ["Engine/Source", "Editor/Source", "Engine/ThirdParty/Vulkan/Include"],
      "lib_dirs": ["Engine/ThirdParty/Vulkan/Lib/Win"],
      "libs": ["vulkan-1.lib"],
      "lib_dirs_linux": ["Engine/ThirdParty/Vulkan/Lib/Linux/VulkanLoader/lib"],
      "libs_linux": ["vulkan"],
      "dependencies": ["Core", "Math", "RHI", "Renderer", "Physics", "Audio", "Assets", "ECS", "Runtime"],
      "defines": ["BUN_EDITOR"]
    },
    {
      "name": "Sandbox",
      "kind": "Executable",
      "target": "Sandbox",
      "source_dirs": ["Sandbox/Source"],
      "include_dirs": ["Engine/Source", "Engine/ThirdParty/Vulkan/Include"],
      "lib_dirs": ["Engine/ThirdParty/Vulkan/Lib/Win"],
      "libs": ["vulkan-1.lib"],
      "lib_dirs_linux": ["Engine/ThirdParty/Vulkan/Lib/Linux/VulkanLoader/lib"],
      "libs_linux": ["vulkan"],
      "dependencies": ["Core", "Math", "RHI", "Renderer", "Physics", "Audio", "Assets", "ECS", "Runtime"],
      "defines": ["BUN_SANDBOX"]
    }
  ]
}